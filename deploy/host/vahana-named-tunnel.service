[Unit]
Description=Cloudflare named tunnel for the vahana gateway
After=network-online.target docker.service
Wants=network-online.target

[Service]
User=ubuntu
ExecStart=/usr/bin/cloudflared --no-autoupdate --config /home/ubuntu/deploy/cloudflared/config.yml tunnel run
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
